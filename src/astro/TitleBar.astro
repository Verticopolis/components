---
// The title bar a Verticopolis docs site draws as its Starlight Header: the
// logo and the site's name, the site's search, the button to the game, the
// GitHub mark and the theme switch. styles/title-bar.css styles it. It reads
// nothing from Starlight, so a site passes its own name and front page (from
// Astro.locals.starlightRoute), and Starlight's Search and ThemeSelect in the
// `search` and `theme` slots. A phone shows the short name and the short
// button label; the full ones stay for screen readers. Starlight puts the
// menu button beside it on pages with a side menu.
//
// The game button carries `data-game-link`, so a site can turn it into Back
// to game in a tab the game opened.

interface Props {
  /** The logo: an imported image, or anything with its src and size. */
  logo: { src: string; width: number; height: number };
  /** The site's name in full. */
  title: string;
  /** The site's name on a phone, such as "Help". */
  short: string;
  /** Where the logo and the name go: the site's front page. */
  href: string;
  /** The site's source on GitHub. */
  github: string;
  /** Where the game button goes; the game's own address unless given. */
  game?: string;
}

const { logo, title, short, href, github, game = "https://verticopolis.com/" } = Astro.props;
---

<div class="vc-bar">
  <a href={href} class="site-title vc-bar-title">
    <img src={logo.src} width={logo.width} height={logo.height} alt="" />
    <span class="vc-name" translate="no"
      ><span class="vc-full">{title}</span><span class="vc-short" aria-hidden="true">{short}</span></span
    >
  </a>
  <div class="vc-bar-search print:hidden"><slot name="search" /></div>
  <div class="vc-bar-links print:hidden">
    <a class="vc-bar-game" href={game} data-game-link
      ><span class="vc-full">Play the game</span><span class="vc-short" aria-hidden="true">Play</span></a
    >
    <a class="vc-bar-github" href={github}
      ><span class="vc-sr-only">GitHub</span><svg
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="currentColor"
        ><path
          d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"
        ></path></svg
      ></a
    >
    <div class="vc-bar-theme"><slot name="theme" /></div>
  </div>
</div>
