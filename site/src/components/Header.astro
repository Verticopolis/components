---
// The site's header: the menu bar on top (MenuBar.astro), then the package's
// title bar (TitleBar.astro, styled by styles/title-bar.css), the one the
// player's manual and the engine docs draw, with this site's Starlight search
// and theme switch.
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import TitleBar from "../../../lib/astro/TitleBar.astro";
import MenuBar from "./MenuBar.astro";
import Mermaid from "./Mermaid.astro";
import { GAME, GITHUB } from "../../site.mjs";
import logo from "../../../assets/app-icon/pwa-192x192.png";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<MenuBar />
<TitleBar logo={logo} title={siteTitle} short="Components" href={siteTitleHref} github={GITHUB} game={GAME}>
  <Search slot="search" />
  <ThemeSelect slot="theme" />
</TitleBar>
<Mermaid />
