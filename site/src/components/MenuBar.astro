---
// The site's Win95 menu bar across the top of every page, above its title
// bar, as the player's manual and the game draw theirs. It is the package's
// site menu (windows/siteMenu) with this site's own File and Help items.
// The sample menu bar, with made-up items, is a demo on its own page.
---

<div id="site-menubar-host"></div>

<script>
  import { mountSiteMenu, schemeDeps, starlightDeps } from "../../../lib/ui/siteMenu.js";
  import { ENGINE_DOCS, GAME, GITHUB, GITHUB_ISSUES, NPM, PLAYER_HELP, SCHEME_KEY } from "../../site.mjs";

  const root = document.getElementById("site-menubar-host");
  if (root) {
    mountSiteMenu(
      root,
      { ...starlightDeps(), ...schemeDeps(SCHEME_KEY) },
      {
        file: [
          { label: "Play Verticopolis", href: GAME },
          { label: "Get the Package on npm", href: NPM },
          { label: "View the Source on GitHub", href: GITHUB },
        ],
        help: [
          { label: "Player's Manual", href: PLAYER_HELP },
          { label: "Engine Docs", href: ENGINE_DOCS },
          { kind: "separator" },
          { label: "Report a Problem…", href: GITHUB_ISSUES, target: "_blank", rel: "noopener noreferrer" },
        ],
      },
    );
  }
</script>
