---
// The site's Win95 menu bar across the top of every page, above its title
// bar, as the player's manual and the game draw theirs. The package's
// MenuBar draws it here from gallery/siteMenu.ts's model, which also says
// what each item does. The sample menu bar, with made-up items, is a demo on
// its own page.
---

<div id="site-menubar-host"></div>

<script>
  import { mountSiteMenu, type SiteTheme } from "../../../gallery/siteMenu";
  import { ENGINE_DOCS, GAME, GITHUB, GITHUB_ISSUES, NPM, PLAYER_HELP, SCHEMES, SCHEME_KEY } from "../../site.mjs";

  const root = document.getElementById("site-menubar-host");
  if (root) {
    const themeSelect = () => document.querySelector<HTMLSelectElement>("starlight-theme-select select");
    mountSiteMenu(
      root,
      {
        print: () => window.print(),
        openSearch: () => document.querySelector<HTMLButtonElement>("site-search button[data-open-modal]")?.click(),
        copyLink: (url) => navigator.clipboard.writeText(url),
        pageUrl: () => location.origin + location.pathname,
        theme: () => {
          const value = themeSelect()?.value;
          return value === "light" || value === "dark" ? value : "auto";
        },
        setTheme: (theme: SiteTheme) => {
          const select = themeSelect();
          if (!select) return;
          select.value = theme;
          select.dispatchEvent(new Event("change"));
        },
        scheme: () => document.documentElement.getAttribute("data-scheme") ?? "classic",
        setScheme: (scheme) => {
          if (scheme === "classic") document.documentElement.removeAttribute("data-scheme");
          else document.documentElement.setAttribute("data-scheme", scheme);
          try {
            localStorage.setItem(SCHEME_KEY, scheme);
          } catch {
            // Private browsing: the pick lasts for this page only.
          }
        },
      },
      { game: GAME, npm: NPM, github: GITHUB, playerHelp: PLAYER_HELP, engineDocs: ENGINE_DOCS, issues: GITHUB_ISSUES },
      SCHEMES,
    );
  }
</script>
