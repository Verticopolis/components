{
  "name": "@verticopolis/components",
  "version": "2.5.0",
  "description": "Verticopolis's renderer, Excalibur scene, Win95 windows and menus, and audio, with the game's CC BY art. They read a render model each game fills from its simulation.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verticopolis/components.git"
  },
  "homepage": "https://github.com/Verticopolis/components#readme",
  "bugs": "https://github.com/Verticopolis/components/issues",
  "engines": {
    "node": "26.x"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./render/*": {
      "types": "./lib/render/*.d.ts",
      "default": "./lib/render/*.js"
    },
    "./presentation/*": {
      "types": "./lib/presentation/*.d.ts",
      "default": "./lib/presentation/*.js"
    },
    "./model/*": {
      "types": "./lib/model/*.d.ts",
      "default": "./lib/model/*.js"
    },
    "./audio/*": {
      "types": "./lib/audio/*.d.ts",
      "default": "./lib/audio/*.js"
    },
    "./windows/*": {
      "types": "./lib/ui/*.d.ts",
      "default": "./lib/ui/*.js"
    },
    "./styles/*": "./lib/styles/*",
    "./astro/*": "./lib/astro/*",
    "./styles.css": "./lib/styles.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "astro-component"
  ],
  "files": [
    "lib",
    "ASSETS-LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint src scripts gallery e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icon-paths.ts",
    "icons:check": "node scripts/gen-icon-paths.ts && git diff --exit-code -- src/ui/iconPaths.generated.ts",
    "test": "vitest run",
    "build": "sh scripts/build-lib.sh",
    "prepack": "sh scripts/build-lib.sh",
    "pack": "sh scripts/pack-components.sh",
    "gallery": "npm run --prefix site dev",
    "gallery:build": "npm run --prefix site build",
    "gallery:install": "npm ci --prefix site",
    "atlas": "tsx scripts/export-atlas.ts",
    "screenshots": "playwright test",
    "screenshots:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "excalibur": "^1.0.0",
    "lit-html": "^3.3.3",
    "tone": "^15.1.22"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "excalibur": "^1.0.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "lit-html": "^3.3.3",
    "pixelarticons": "^2.2.0",
    "playwright": "^1.61.1",
    "prettier": "3.10.1",
    "tone": "^15.1.22",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uri-js": "npm:fast-uri@^3.1.9"
  }
}
