{
  "name": "@verticopolis/components",
  "version": "0.2.2",
  "description": "Verticopolis's renderer, Excalibur scene, Win95 windows and menus, audio, the engine binding and host, with the game's CC BY art.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verticopolis/components.git"
  },
  "homepage": "https://github.com/Verticopolis/components#readme",
  "bugs": "https://github.com/Verticopolis/components/issues",
  "engines": {
    "node": "26.x"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./render/*": {
      "types": "./lib/render/*.d.ts",
      "default": "./lib/render/*.js"
    },
    "./presentation/*": {
      "types": "./lib/presentation/*.d.ts",
      "default": "./lib/presentation/*.js"
    },
    "./catalog/*": {
      "types": "./lib/catalog/*.d.ts",
      "default": "./lib/catalog/*.js"
    },
    "./model/*": {
      "types": "./lib/model/*.d.ts",
      "default": "./lib/model/*.js"
    },
    "./shared/*": {
      "types": "./lib/model/*.d.ts",
      "default": "./lib/model/*.js"
    },
    "./binding/*": {
      "types": "./lib/engineBinding/*.d.ts",
      "default": "./lib/engineBinding/*.js"
    },
    "./port/*": {
      "types": "./lib/simport/*.d.ts",
      "default": "./lib/simport/*.js"
    },
    "./host/*": {
      "types": "./lib/wasmhost/*.d.ts",
      "default": "./lib/wasmhost/*.js"
    },
    "./events/*": {
      "types": "./lib/events/*.d.ts",
      "default": "./lib/events/*.js"
    },
    "./audio/*": {
      "types": "./lib/audio/*.d.ts",
      "default": "./lib/audio/*.js"
    },
    "./windows/*": {
      "types": "./lib/ui/*.d.ts",
      "default": "./lib/ui/*.js"
    },
    "./fixtures/*": "./lib/simport/fixtures/*",
    "./styles/*": "./lib/styles/*",
    "./styles.css": "./lib/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "ASSETS-LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p gallery/tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icon-paths.ts",
    "icons:check": "node scripts/gen-icon-paths.ts && git diff --exit-code -- src/ui/iconPaths.generated.ts",
    "test": "vitest run",
    "build": "sh scripts/build-lib.sh",
    "prepack": "sh scripts/build-lib.sh",
    "pack": "sh scripts/pack-components.sh",
    "gallery": "vite -c gallery/vite.config.ts",
    "gallery:build": "vite build -c gallery/vite.config.ts",
    "atlas": "tsx scripts/export-atlas.ts",
    "screenshots": "playwright test",
    "screenshots:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "@verticopolis/engine": "^1.57.1",
    "excalibur": "^1.0.0",
    "lit-html": "^3.3.3",
    "tone": "^15.1.22"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.6.6",
    "@verticopolis/engine": "https://github.com/Verticopolis/engine/releases/download/engine-v1.57.1/verticopolis-engine-1.57.1.tgz",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "excalibur": "^1.0.0",
    "happy-dom": "^21.0.4",
    "lit-html": "^3.3.3",
    "pixelarticons": "^2.2.0",
    "playwright": "^1.61.1",
    "prettier": "3.10.1",
    "tone": "^15.1.22",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
